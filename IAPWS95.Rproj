Version: 1.0
ProjectId: 4cb3cb07-562d-40fc-bb67-78bbd6bb66cc

RestoreWorkspace: Default
SaveWorkspace: Default
AlwaysSaveHistory: Default

EnableCodeIndexing: Yes
UseSpacesForTab: Yes
NumSpacesForTab: 2
Encoding: UTF-8

RnwWeave: Sweave
LaTeX: pdfLaTeX

BuildType: Package
PackageUseDevtools: Yes
PackageInstallArgs: --no-multiarch --with-keep.source --no-lock --debug --no-clean-on-error --use-LTO
PackageBuildBinaryArgs: --use-LTO
PackageCheckArgs: --as-cran
PackageRoxygenize: vignette
